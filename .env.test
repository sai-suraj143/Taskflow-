# Environment for the Jest suite ONLY. Never used by `npm run dev` / `npm run worker`
# or by the Docker images (both are excluded via .dockerignore).
#
# Same Postgres/Redis instances as .env, different database name / logical Redis DB, so
# `npm test` can never touch the Days 1-8 development data in taskflow_dev.
PORT=3001
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow123
POSTGRES_DB=taskflow_test
DATABASE_URL=postgresql://taskflow:taskflow123@localhost:5432/taskflow_test?schema=public
# Same Redis server as dev, but logical DB 1 instead of the default DB 0. Job creation
# really does enqueue into BullMQ (that is production code under test, not a stub), so
# isolating the keyspace stops test queue messages from ever being seen by a dev worker
# running on the host, and stops test rate-limit counters from sharing keys with dev.
REDIS_URL=redis://localhost:6379/1
NODE_ENV=test
JWT_SECRET=test-only-secret-9f2c1a7e4b6d8305cae1f47b29d0836e5f4a1c7b2d9e6083af15c7b4e29d061
JWT_EXPIRES_IN=1h
# Lowered so the suite is not at the mercy of wall-clock timing: the fixed window would
# otherwise reset mid-run and make counts non-deterministic.
BCRYPT_SALT_ROUNDS=10
RETRY_BACKOFF_BASE_MS=100
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_MAX_REQUESTS=100000