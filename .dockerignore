# Keep the build context small and, more importantly, keep secrets and the test
# harness out of the image. Anything listed here is invisible to `docker build`, so it
# can never end up in a layer of the final image.

# Dependencies are reinstalled inside the image from the lockfile.
node_modules

# Secrets. The containers get their configuration from compose `env_file`/`environment`
# on the HOST at run time, so these never need to be baked into a layer.
.env
.env.test

# Test harness has no place in a runtime image.
tests
jest.config.js
coverage

# VCS / editor / OS noise.
.git
.gitattributes
.gitignore
.vscode
.idea
.DS_Store

# Docker's own compose file is run-time config, not image content.
docker-compose.yml

# Misc.
README.md
npm-debug.log
*.log
Dockerfile
.dockerignore
target
dist